# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copie para .env e preencha os valores reais
# ─────────────────────────────────────────────────────────────────────────────

# ── MQTT ─────────────────────────────────────────────────────────────────────
# Broker próprio (mosquitto-central do docker compose), só TLS (8883). Os serviços
# do compose já usam "mosquitto-central"; estes valores valem para scripts na
# máquina (ex.: python plataforma/simuladores/mock_incendio.py).
MQTT_BROKER=localhost
MQTT_PORT=8883

# ── Banco (PostgreSQL + TimescaleDB) ─────────────────────────────────────────
POSTGRES_DB=sentinela
POSTGRES_USER=sentinela
POSTGRES_PASSWORD=sentinela
POSTGRES_PORT=5433

# ── Segurança (etapa A4) ─────────────────────────────────────────────────────
# Valores SÓ para desenvolvimento — troque todos fora da sua máquina.
# Gere um valor novo com:  python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Segredo de provisionamento dos dispositivos SIMULADOS: a credencial de cada um
# é derivada dele (não há fábrica para gravá-la no aparelho). A central guarda
# só o hash. Dispositivos cadastrados pela API recebem credencial própria.
SEGREDO_PROVISIONAMENTO=dev-provisionamento-troque-esta-senha
# Credencial de cada nó de borda: HTTP Basic com a central e bridge MQTT
CREDENCIAL_BORDA_TOCANTINS=dev-borda-tocantins-troque-esta-senha
CREDENCIAL_BORDA_GOIAS=dev-borda-goias-troque-esta-senha
# Usuários de serviço dos brokers
MQTT_SENHA_CENTRAL=dev-central-troque-esta-senha
MQTT_SENHA_SIMULACAO=dev-simulacao-troque-esta-senha
# Console de administração do Keycloak (http://localhost:8080, usuário admin)
KEYCLOAK_ADMIN_SENHA=dev-keycloak-troque-esta-senha

# ── Nós de borda (fog) ───────────────────────────────────────────────────────
# Chave Fernet que cifra a fila local de cada borda (RF-SEG-05).
# Valores abaixo são SÓ para desenvolvimento. Gere novas com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BORDA_CHAVE_TOCANTINS=KRrj6hvdJkSvCbMjX2biHGxlEGtUTxCbn6FGzRP_SjM=
BORDA_CHAVE_GOIAS=kto1WTuDmujzYSilg-Ys1Or3pSFqShgvKPPAF29wqV4=

# ── NASA FIRMS ────────────────────────────────────────────────────────────────
# Chave de acesso à API NASA FIRMS (Fire Information for Resource Management)
# Obtenha GRATUITAMENTE em: https://firms.modaps.eosdis.nasa.gov/api/
# Usada pelas estações simuladas (proxy de fumaça) e pelo conector FIRMS
FIRMS_MAP_KEY=

# Fonte de dados FIRMS: VIIRS_SNPP_NRT | VIIRS_NOAA20_NRT | MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT

# Janela temporal em dias para consulta de focos (1 = últimas 24 h)
FIRMS_DAYS=1

# Raio de busca (graus decimais) ao redor da coordenada da zona
# 0.25° ≈ 28 km  (sensor.py usa raio maior para detecção de fumaça regional)
# 0.15° ≈ 16 km  (conector FIRMS usa raio menor para confirmação local)
FIRMS_RAIO_GRAUS=0.15

# ── Sensor — frequência de atualização das APIs ───────────────────────────────
# Open-Meteo (temperatura/umidade reais) — intervalo em minutos
# Recomendado: 10 min (Open-Meteo atualiza a cada ~15 min, sem limite de quota)
SENSOR_REFRESH_METEO_MIN=10

# NASA FIRMS (índice de fumaça por focos de calor) — intervalo em minutos
# Recomendado: 30 min (VIIRS NRT atualiza a cada 10-15 min por passagem)
SENSOR_REFRESH_FIRMS_MIN=30

# ── Sensor — mock manual de incêndio (demonstração) ───────────────────────────
# Zona que passa a ignorar Open-Meteo/FIRMS e usar valores fixos abaixo.
# Vazio = desabilitado. Deve ser uma zona de plataforma/simuladores/zonas.py (ex.: mateiros).
MOCK_ZONA_INCENDIO=
MOCK_TEMPERATURA=42.0
MOCK_UMIDADE=10.0
MOCK_FUMACA=93.0

# Coordenada opcional: reposiciona o marcador da zona mockada no mapa e o
# foco fabricado pelo conector FIRMS. Vazio = usa a coordenada real da zona.
MOCK_LAT=
MOCK_LON=

# ── Conector FIRMS / regras locais da borda ───────────────────────────────────
# Intervalo (segundos) entre varreduras FIRMS da mesma zona
FIRMS_COOLDOWN_SEG=600
ALERTA_COOLDOWN_SEG=30

# ── Atuador ───────────────────────────────────────────────────────────────────
# Cooldown mínimo (segundos) entre ações repetidas para a mesma zona
ACAO_COOLDOWN_SEG=30
