# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copie para .env e preencha os valores reais
# ─────────────────────────────────────────────────────────────────────────────

# ── MQTT ─────────────────────────────────────────────────────────────────────
# Endereço do broker (padrão: broker público HiveMQ)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_BASE=sentinela-iot-2026-joao-carol/monitoramento-br

# ── NASA FIRMS ────────────────────────────────────────────────────────────────
# Chave de acesso à API NASA FIRMS (Fire Information for Resource Management)
# Obtenha GRATUITAMENTE em: https://firms.modaps.eosdis.nasa.gov/api/
# Usada pelo sensor.py (proxy de fumaça) e pelo gateway.py (confirmação de risco)
FIRMS_MAP_KEY=

# Fonte de dados FIRMS: VIIRS_SNPP_NRT | VIIRS_NOAA20_NRT | MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT

# Janela temporal em dias para consulta de focos (1 = últimas 24 h)
FIRMS_DAYS=1

# Raio de busca (graus decimais) ao redor da coordenada da zona
# 0.25° ≈ 28 km  (sensor.py usa raio maior para detecção de fumaça regional)
# 0.15° ≈ 16 km  (gateway.py usa raio menor para confirmação local)
FIRMS_RAIO_GRAUS=0.15

# ── Sensor — frequência de atualização das APIs ───────────────────────────────
# Open-Meteo (temperatura/umidade reais) — intervalo em minutos
# Recomendado: 10 min (Open-Meteo atualiza a cada ~15 min, sem limite de quota)
SENSOR_REFRESH_METEO_MIN=10

# NASA FIRMS (índice de fumaça por focos de calor) — intervalo em minutos
# Recomendado: 30 min (VIIRS NRT atualiza a cada 10-15 min por passagem)
SENSOR_REFRESH_FIRMS_MIN=30

# ── Sensor — mock manual de incêndio (demonstração) ───────────────────────────
# Zona que passa a ignorar Open-Meteo/FIRMS e usar valores fixos abaixo.
# Vazio = desabilitado. Deve ser um id de ZONA_COORDS (ex.: mateiros).
MOCK_ZONA_INCENDIO=
MOCK_TEMPERATURA=42.0
MOCK_UMIDADE=10.0
MOCK_FUMACA=93.0

# Coordenada opcional: reposiciona o marcador da zona mockada no mapa e a
# consulta FIRMS do gateway.py. Vazio = usa a coordenada real da zona.
MOCK_LAT=
MOCK_LON=

# ── Gateway ───────────────────────────────────────────────────────────────────
# Cooldown mínimo (segundos) entre consultas FIRMS para a mesma zona
FIRMS_COOLDOWN_SEG=600
ALERTA_COOLDOWN_SEG=30

# ── Atuador ───────────────────────────────────────────────────────────────────
# Cooldown mínimo (segundos) entre ações repetidas para a mesma zona
ACAO_COOLDOWN_SEG=30
