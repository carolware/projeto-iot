{
  "realm": "sentinela",
  "displayName": "Sentinela — Plataforma IoT Integrada",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrador da plataforma (qualquer inquilino)"
      },
      {
        "name": "gestor",
        "description": "Responsável por um inquilino: catálogo, regras, assinaturas"
      },
      {
        "name": "operador",
        "description": "Acompanha painéis e alarmes, envia comandos"
      },
      {
        "name": "integrador",
        "description": "Conecta projetos: dispositivos, perfis, credenciais"
      },
      {
        "name": "leitor",
        "description": "Somente consulta"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sentinela-api",
      "name": "API da instância central",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "painel",
      "name": "Painel web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "audiencia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "sentinela-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "inquilino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "inquilino",
            "claim.name": "inquilino",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cli",
      "name": "Scripts de demonstração (somente desenvolvimento)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audiencia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "sentinela-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "inquilino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "inquilino",
            "claim.name": "inquilino",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
